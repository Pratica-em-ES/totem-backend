# Spring Profile
# Use 'local' for development with H2 in-memory database (no database setup required!)
# Use 'prod' for production with PostgreSQL/Supabase
# Dev environment is not implemented 
SPRING_PROFILES_ACTIVE=

# Database URL (only needed when SPRING_PROFILES_ACTIVE=prod)
# Example: DATABASE_URL=jdbc:postgresql://aws-1-sa-east-1.pooler.supabase.com:5432/postgres?user=postgres.xxxxx&password=yourpassword&sslmode=require
DATABASE_URL=

# Setup the port which the application will run on (default is 8080)
# Example: PORT=8080
PORT=